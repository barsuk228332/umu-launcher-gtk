msgid "GAMEID set to %s"
msgstr "GAMEID изменён на %s"

msgid "not created"
msgstr "не создан"

msgid "Creating prefix…"
msgstr "Создаём префикс…"

msgid "Prefix ready"
msgstr "Префикс готов"

msgid "Prefix creation failed (code %d). Try another Proton build."
msgstr "Не удалось создать префикс (код %d). Попробуйте другую сборку Proton."

msgid "Prefix does not exist"
msgstr "Префикс не существует"

msgid "Refusing to delete this folder"
msgstr "Отказываюсь удалять эту папку"

msgid "Deleting prefix…"
msgstr "Удаляем префикс…"

msgid "Prefix deleted"
msgstr "Префикс удалён"

msgid "Delete this prefix?"
msgstr "Удалить этот префикс?"

msgid "Everything inside %s will be removed, including saves stored in the prefix."
msgstr "Всё содержимое %s будет удалено, включая сохранения внутри префикса."

msgid "Delete"
msgstr "Удалить"

msgid "No cover found"
msgstr "Обложка не найдена"

msgid "Choose a cover image"
msgstr "Выберите обложку"

msgid "Run winetricks"
msgstr "Запустить winetricks"

msgid "Space separated verbs, for example: vcrun2022 d3dx9"
msgstr "Вербы через пробел, например: vcrun2022 d3dx9"

msgid "Run"
msgstr "Запустить"

msgid "No verbs given"
msgstr "Не указаны вербы"

msgid "winetricks finished"
msgstr "winetricks завершён"

msgid "Shortcut created: %s"
msgstr "Ярлык создан: %s"

msgid "Remove “%s” from the library?"
msgstr "Убрать «%s» из библиотеки?"

msgid "The executable, prefix and saves are not touched."
msgstr "Исполняемый файл, префикс и сохранения не затрагиваются."

msgid "Log: %s"
msgstr "Лог: %s"

msgid "Copy all"
msgstr "Скопировать всё"

msgid "Clear view"
msgstr "Очистить"

msgid "Open log folder"
msgstr "Открыть папку логов"

msgid "Games keep running after the window is closed"
msgstr "Игры продолжат работать после закрытия окна"

msgid "Library"
msgstr "Библиотека"

msgid "Add a game"
msgstr "Добавить игру"

msgid "Search library"
msgstr "Поиск по библиотеке"

msgid "No games yet"
msgstr "Пока нет игр"

msgid "Add a Windows game executable and launch it through umu-run."
msgstr "Добавьте исполняемый файл Windows-игры и запускайте его через umu-run."

