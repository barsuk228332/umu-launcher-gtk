msgid "Prefix folder"
msgstr "Папка префикса"

msgid "Create prefix"
msgstr "Создать префикс"

msgid "Open in file manager"
msgstr "Открыть в файловом менеджере"

msgid "Delete prefix"
msgstr "Удалить префикс"

msgid "Size on disk"
msgstr "Занято на диске"

msgid "Edit"
msgstr "Изменить"

msgid "Cover"
msgstr "Обложка"

msgid "placeholder"
msgstr "заглушка"

msgid "Download"
msgstr "Скачать"

msgid "Choose a local image"
msgstr "Выбрать локальное изображение"

msgid "Extra options"
msgstr "Дополнительно"

msgid "Run the game inside the gamescope compositor"
