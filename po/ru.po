msgid "A small GTK4 frontend for umu-launcher."
msgstr "Небольшой GTK4-интерфейс для umu-launcher."

msgid "Choose the game executable"
msgstr "Выберите исполняемый файл игры"

msgid "GAMEID suggestion applied: %s"
msgstr "Подставлен GAMEID: %s"

msgid "Launching %s…"
msgstr "Запуск «%s»…"

msgid "Stopping game…"
msgstr "Останавливаем игру…"

msgid "none"
msgstr "нет"

msgid "System language"
msgstr "Язык системы"

msgid "line %d: expected KEY=VALUE"
msgstr "строка %d: ожидается KEY=VALUE"

msgid "line %d: invalid variable name"
msgstr "строка %d: недопустимое имя переменной"

msgid "Environment variables"
msgstr "Переменные окружения"

msgid "Save"
msgstr "Сохранить"

msgid "One KEY=VALUE pair per line. Lines starting with # are ignored."
msgstr "По одной паре KEY=VALUE в строке. Строки, начинающиеся с #, игнорируются."

msgid "Find a GAMEID"
msgstr "Найти GAMEID"

msgid "Game title"
msgstr "Название игры"

msgid "Loading umu-database…"
msgstr "Загружаем umu-database…"

msgid "umu-database is empty. Open Settings and press “Update umu-database”."
msgstr "База umu-database пуста. Откройте настройки и нажмите «Обновить umu-database»."

msgid "%d games in the database"
msgstr "Игр в базе: %d"

msgid "Nothing found"
msgstr "Ничего не найдено"

msgid "%d matches"
msgstr "Совпадений: %d"

msgid "Settings"
msgstr "Настройки"

msgid "Appearance"
msgstr "Внешний вид"

msgid "Interface language"
msgstr "Язык интерфейса"

msgid "Runtime"
msgstr "Среда выполнения"

msgid "Defaults applied when a game does not override them."
msgstr "Значения по умолчанию, если игра не переопределяет их."

msgid "Default Proton"
msgstr "Proton по умолчанию"

msgid "Used for new games and prefix creation"
msgstr "Используется для новых игр и создания префиксов"

msgid "Prefix directory"
msgstr "Каталог префиксов"

msgid "Debug logs"
msgstr "Отладочные логи"

