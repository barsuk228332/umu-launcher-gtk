msgstr "Для SteamGridDB нужен бесплатный API-ключ: steamgriddb.com/profile/preferences/api"

msgid "SteamGridDB API key"
msgstr "API-ключ SteamGridDB"

msgid "Steam CDN fallback"
msgstr "Резервный Steam CDN"

msgid "Download free square covers when SteamGridDB finds nothing"
msgstr "Скачивать бесплатные обложки, если SteamGridDB ничего не нашёл"

msgid "umu-database"
msgstr "umu-database"

msgid "Update umu-database"
msgstr "Обновить umu-database"

msgid "Used to suggest GAMEID values for protonfixes"
msgstr "Нужна для подсказок GAMEID для protonfixes"

msgid "Update"
msgstr "Обновить"

msgid "About"
msgstr "О программе"

msgid "A GTK4 frontend for umu-launcher. Version %s"
msgstr "GTK4-интерфейс для umu-launcher. Версия %s"

